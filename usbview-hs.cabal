cabal-version: 3.0
name:          usbview-hs
version:       1.0.0
synopsis:      Inspect USB controllers, hubs and devices on macOS
description:   Reads the macOS IORegistry and reports USB topology as a tree or JSON.
category:      System
license:       MIT
license-file:  LICENSE
build-type:    Simple
tested-with:   GHC == 9.10.3
extra-doc-files:
    README.md
    README.ru.md
extra-source-files:
    Makefile
    app/*.swift
    app/Info.plist
    app/en.lproj/Localizable.strings
    tests/AppTest.swift

common engine
    default-language: Haskell2010
    hs-source-dirs:   engine
    other-modules:
        Output
        Properties
        Registry
        Topology
    build-depends:
        base        >= 4.14 && < 5,
        bytestring  >= 0.10 && < 0.13,
        containers  >= 0.6  && < 0.9,
        text        >= 1.2  && < 2.2
    ghc-options: -Wall
    if os(osx)
        frameworks: IOKit, CoreFoundation
        ghc-options: -opta-mmacosx-version-min=15.0 -optc-mmacosx-version-min=15.0
        ld-options:  -mmacosx-version-min=15.0 -Wl,-dead_strip
    else
        buildable: False

executable usbview-hs
    import:        engine
    main-is:       Main.hs
    build-depends: time >= 1.9 && < 2

test-suite topology
    import:         engine
    type:           exitcode-stdio-1.0
    hs-source-dirs: tests
    main-is:        TopologyTest.hs
